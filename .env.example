# Copie este arquivo para ".env" e coloque sua chave do Google AI Studio.
# NUNCA suba o arquivo .env para o GitHub.
GEMINI_API_KEY=coloque_sua_chave_aqui
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=60000
# Raciocínio do modelo: low (mais rápido), medium, high ou padrao
GEMINI_THINKING=low
# Use false para testar sem IA (modo reserva por regras)
USAR_IA=true
